{
	"$schema": "https://www.schemastore.org/package",
	"name": "@dariah-eric/stardast-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"build": "bun run --bun astro build",
		"dev": "bun run --bun astro dev",
		"format:check": "bun run --bun oxfmt --check",
		"format:fix": "bun run --bun oxfmt --write",
		"lint:check": "FORCE_COLOR=1 bun run --parallel lint:code:check lint:styles:check",
		"lint:code:check": "bun run --bun oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "bun run --bun oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "FORCE_COLOR=1 bun run --parallel lint:code:fix lint:styles:fix",
		"lint:styles:check": "bun run --bun stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "bun run --bun stylelint \"./**/*.css\" --cache --fix --ignore-path ./.gitignore",
		"start": "bun run --bun astro preview",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts --update-snapshots=missing",
		"test:e2e:nvda": "playwright test --config ./e2e/nvda.config.ts",
		"test:unit": "bun test ./tests/",
		"types:check": "bun run --bun tsc --noEmit --runExternalCode"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@astrojs/node": "^11.1.11",
		"@astrojs/react": "^7.1.4",
		"@internationalized/date": "^3.12.4",
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-subscript": "^3.33.0",
		"@tiptap/extension-superscript": "^3.33.0",
		"@tiptap/pm": "^3.33.0",
		"@tiptap/react": "^3.33.0",
		"@tiptap/starter-kit": "^3.33.0",
		"astro": "^7.4.7",
		"better-result": "^3.0.1",
		"invokers-polyfill": "^1.0.4",
		"lucide-react": "^1.70.0",
		"minisearch": "^7.2.0",
		"react": "^19.3.0",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"valibot": "^1.5.0",
		"xast-util-feed": "^2.0.0",
		"xast-util-to-xml": "^4.0.0"
	},
	"devDependencies": {
		"@astrojs/compiler-rs": "^0.5.2",
		"@astrojs/ts-content-mapper": "^0.2.0",
		"@guidepup/guidepup": "^0.40.0",
		"@guidepup/playwright": "^0.21.0",
		"@playwright/cli": "^0.1.23",
		"@playwright/test": "^1.65.0",
		"@react-aria/optimize-locales-plugin": "^2.1.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-playwright": "^2.12.2",
		"eslint-plugin-regexp": "^3.3.3",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"oxlint-tsgolint": "^7.0.2006",
		"stylelint": "^18.0.0",
		"stylelint-order": "^8.1.3",
		"tailwindcss": "^4.3.5",
		"tailwindcss-react-aria-components": "^2.2.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.1.0-dev.20261106.1",
		"vite": "^8.3.6"
	},
	"browserslist": [
		"chrome >= 111",
		"firefox >= 128",
		"safari >= 16.4",
		"ios_saf >= 16.4"
	],
	"stylelint": {
		"extends": "./configs/stylelint/base.json"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.4.4",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "bun",
				"version": "^1.4.4",
				"onFail": "download"
			},
			{
				"name": "node",
				"version": "^26.13.0",
				"onFail": "warn"
			}
		]
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.4.4",
			"onFail": "download"
		}
	},
	"patchedDependencies": {
		"astro@7.4.7": "patches/astro@7.4.7.patch"
	}
}
