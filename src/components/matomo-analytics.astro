---
import { env } from "#/configs/env.config.ts";
import { type PageTracking, getTrackerCommands } from "#/src/lib/analytics/matomo-tracking.ts";

export interface Props {
	tracking?: PageTracking;
}

const { tracking = { kind: "pageView" } } = Astro.props;

const siteId = env.PUBLIC_APP_MATOMO_ID;
const baseUrl = `${env.PUBLIC_APP_MATOMO_BASE_URL.replace(/\/$/, "")}/`;

/** Editors previewing drafts are not visitors. */
const isEnabled = siteId != null && Astro.locals.preview == null;

/**
 * A page which is prerendered on hover, see the speculation rules in `document-layout.astro`, is only tracked once it
 * is shown, as it may never be. Matomo's own check, `setCountPreRendered`, looks for the legacy `visibilityState`
 * "prerender", which browsers no longer set. Rather than deferring only the commands, the tracker itself is loaded once
 * the page is shown, as it ignores commands which are queued after it has loaded without any.
 */
const commands =
	siteId != null
		? getTrackerCommands({
				trackerUrl: `${baseUrl}matomo.php`,
				siteId,
				url: tracking.url != null ? new URL(tracking.url, Astro.site).href : undefined,
				tracking,
			})
		: [];
---

{isEnabled && <script is:inline define:vars={{ commands, src: `${baseUrl}matomo.js` }}>
	function track() {
		const queue = (window._paq = window._paq || []);
		for (const command of commands) {
			queue.push(command);
		}

		const script = document.createElement("script");
		script.async = true;
		script.src = src;
		document.head.append(script);
	}

	if (document.prerendering) {
		document.addEventListener("prerenderingchange", track, { once: true });
	} else {
		track();
	}
</script>}
