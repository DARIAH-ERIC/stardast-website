---
import CoverImage from "#/src/components/cover-image.astro";
import type { NewsEntryData } from "#/src/cms/config.ts";
import { formatDate } from "#/src/lib/format-date.ts";

export interface Props {
	id: string;
	data: NewsEntryData;
	/** Below the heading of the list it is part of. */
	headingLevel: 2 | 3;
}

const { id, data, headingLevel } = Astro.props;

/** Literal tag names rather than a template string, so that the element's attributes can be type-checked. */
const Heading = ({ 2: "h2", 3: "h3" } as const)[headingLevel];
---

<article class="relative flex h-full flex-col transition-colors has-[a:hover]:bg-background-hover">
	<CoverImage id={data.image} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" />
	<div class="flex flex-col gap-1.5 p-5 sm:p-6">
		<Heading class="order-2 text-title text-balance text-foreground-strong">
			{/* Stretched over the whole card, so that its text stays selectable rather than being a link label. */}
			<a href={`/news/${id}`} class="after:absolute after:inset-0 hover:underline underline-offset-4">{data.title}</a>
		</Heading>
		{/* Shown above the title, but read after it. */}
		<time datetime={data.publicationDate} class="order-1 mono-label text-foreground-muted">
			{formatDate(data.publicationDate)}
		</time>
		<p class="order-3 mt-1 leading-normal text-pretty text-foreground-muted">{data.summary}</p>
	</div>
</article>
