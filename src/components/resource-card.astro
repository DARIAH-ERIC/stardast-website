---
import type { Resource } from "#/src/lib/career-resources.ts";
import { formatPartialDate } from "#/src/lib/format-date.ts";

export interface Props {
	resource: Resource;
	/** Below the heading of the list it is part of. */
	headingLevel: 2 | 3;
}

const { resource, headingLevel } = Astro.props;

/** Literal tag names rather than a template string, so that the element's attributes can be type-checked. */
const Heading = ({ 2: "h2", 3: "h3" } as const)[headingLevel];
---

{/* Like a news card, without an image - but linking to the record on zenodo, since resources have no pages of their own. */}
<article class="relative flex h-full flex-col transition-colors has-[a:hover]:bg-background-hover">
	<div class="flex flex-col gap-1.5 p-5 sm:p-6">
		<Heading class="order-2 text-title text-balance text-foreground-strong">
			{/* Stretched over the whole card, so that its text stays selectable rather than being a link label. */}
			<a href={resource.href} class="after:absolute after:inset-0 hover:underline underline-offset-4">
				{resource.title}
			</a>
		</Heading>
		{/* Shown above the title, but read after it. */}
		<time datetime={resource.publicationDate} class="order-1 mono-label text-foreground-muted">
			{formatPartialDate(resource.publicationDate)}
		</time>
		{resource.summary != null && (
			<p class="order-3 mt-1 leading-normal text-pretty text-foreground-muted">{resource.summary}</p>
		)}
	</div>
</article>
