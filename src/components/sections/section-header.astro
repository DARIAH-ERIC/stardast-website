---
export interface Props {
	eyebrow?: string;
	title?: string;
	lead?: string;
}

const { eyebrow, title, lead } = Astro.props;

/** E.g. a link to all news, at the end of the title's line. */
const hasAction = Astro.slots.has("action");
---

{(eyebrow != null || title != null || lead != null || hasAction) && (
	<header class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
		<div class="flex max-w-prose flex-col items-start gap-4">
			{(eyebrow != null || title != null) && (
				<hgroup class="flex flex-col items-start gap-4">
					{eyebrow != null && <p class="label-marker mono-label text-foreground-strong">{eyebrow}</p>}
					{title != null && <h2 class="text-headline text-balance text-foreground-strong">{title}</h2>}
				</hgroup>
			)}
			{lead != null && <p class="text-lead text-pretty">{lead}</p>}
		</div>
		<slot name="action" />
	</header>
)}
