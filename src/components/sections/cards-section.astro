---
import CmsImage from "#/src/components/cms-image.astro";
import SectionHeader from "#/src/components/sections/section-header.astro";
import type { SectionData } from "#/src/cms/config.ts";

export type Props = SectionData<"cards">;

const { anchor, eyebrow, title, lead, cards } = Astro.props;

/** Card titles are below the section title, if there is one. */
const Heading = title != null ? "h3" : "h2";
---

<section id={anchor}>
	<div class="content-container section-spacing">
		<SectionHeader eyebrow={eyebrow} title={title} lead={lead} />
		{/* A grid of cells sharing their dividing lines: each cell draws its own right and bottom edge. */}
		<ul class="grid border-t border-l border-border-strong sm:grid-cols-2 lg:grid-cols-3" role="list">
			{
				cards.map((card) => {
					return (
						<li class="relative flex flex-col border-r border-b border-border-strong transition-colors has-[a:hover]:bg-background-hover">
							{card.image != null && (
								<CmsImage id={card.image} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" class="aspect-video w-full border-b border-border-strong object-cover" />
							)}
							<div class="flex flex-col gap-3 p-6">
								{card.eyebrow != null && (
									<p class="font-mono text-[0.6875rem]/4 font-medium tracking-[0.08em] text-foreground-muted uppercase">
										{card.eyebrow}
									</p>
								)}
								<Heading class="text-title text-foreground-strong">
									{card.href != null ? (
										/** Stretched over the whole card, so that its text stays selectable rather than being a link label. */
										<a href={card.href} class="after:absolute after:inset-0 hover:underline underline-offset-4">
											{card.title}
										</a>
									) : (
										card.title
									)}
								</Heading>
								{card.text != null && <p class="text-foreground-muted">{card.text}</p>}
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
