---
import type { SectionData } from "#/src/cms/config.ts";
import PartnerCell from "#/src/components/partner-cell.astro";
import SectionHeader from "#/src/components/sections/section-header.astro";
import { fillPartnerCount } from "#/src/lib/partner-count.ts";

export type Props = SectionData<"partners">;

const { anchor, eyebrow, title, lead, links } = Astro.props;

/**
 * Sorted by name - see the collection's `sort`. The project coordinator is shown above the other partners, set apart by
 * a gap, so that it stands out - in a cell of the same size.
 */
const partners = await Astro.locals.content.list("partners");
const coordinators = partners.filter((partner) => partner.data.coordinator === true);
const others = partners.filter((partner) => partner.data.coordinator !== true);

/** Shared by both lists, so that the coordinator's cell is the same size as the others. */
const gridClass = "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4";
---

<section id={anchor} class="content-container section-spacing">
	<SectionHeader
		eyebrow={eyebrow}
		title={fillPartnerCount(title, partners.length)}
		lead={lead != null ? fillPartnerCount(lead, partners.length) : undefined}
	/>
	{coordinators.length > 0 && (
		<div class="mb-8">
			<h3 class="mb-3 mono-label text-foreground-muted">Project coordinator</h3>
			{/*
				A list of its own, apart from the other partners, whose cells draw all four edges. Its left edge is
				transparent, so that its columns are as wide as those of the list below - whose left edge takes up a pixel -
				and each cell draws its own over it.
			*/}
			<ul class:list={[gridClass, "border-l border-transparent"]} role="list">
				{coordinators.map((partner) => {
					return (
						<li class="-ml-px border border-border-strong">
							<PartnerCell data={partner.data} />
						</li>
					);
				})}
			</ul>
		</div>
	)}
	{coordinators.length > 0 && <h3 class="mb-3 mono-label text-foreground-muted">Partners</h3>}
	{/* Cells which share their dividing lines: each draws its own right and bottom edge. */}
	<ul class:list={[gridClass, "border-t border-l border-border-strong"]} role="list">
		{others.map((partner) => {
			return (
				<li class="border-r border-b border-border-strong">
					<PartnerCell data={partner.data} />
				</li>
			);
		})}
	</ul>
	{links.length > 0 && (
		<div class="mt-8 flex flex-wrap gap-4">
			{links.map((link) => {
				return (
					<a
						href={link.href}
						class="mono-label text-primary hover:text-primary-hover hover:underline underline-offset-4"
					>
						{link.label} <span aria-hidden="true">&rarr;</span>
					</a>
				);
			})}
		</div>
	)}
</section>
