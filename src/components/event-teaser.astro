---
import type { EventEntryData } from "#/src/cms/config.ts";
import { formatEventLocation } from "#/src/lib/events.ts";
import { formatDateRange } from "#/src/lib/format-date.ts";

export interface Props {
	id: string;
	data: EventEntryData;
	/** Below the heading of the list it is part of. */
	headingLevel: 2 | 3 | 4;
}

const { id, data, headingLevel } = Astro.props;

/** Literal tag names rather than a template string, so that the element's attributes can be type-checked. */
const Heading = ({ 2: "h2", 3: "h3", 4: "h4" } as const)[headingLevel];

const location = formatEventLocation(data);
---

<article class="relative flex flex-col gap-1.5 py-5">
	<Heading class="order-2 text-title text-balance text-foreground-strong">
		{/* Stretched over the whole row, so that its text stays selectable rather than being a link label. */}
		<a
			href={`/events/${id}`}
			class="after:absolute after:inset-0 hover:text-primary-hover hover:underline underline-offset-4"
		>
			{data.title}
		</a>
	</Heading>
	{/* Shown above the title, but read after it. */}
	<p class="order-1 mono-label text-foreground-muted">
		<time datetime={data.startDate}>{formatDateRange(data.startDate, data.endDate)}</time>
		{location != null && <span>{` · ${location}`}</span>}
	</p>
	<p class="order-3 text-pretty text-foreground-muted">{data.summary}</p>
</article>
