---
import { Card } from "#/src/components/admin/ui/card.tsx";

export interface Props {
	/** The id of the heading which names the table. */
	labelledBy: string;
	/** The first column holds the row headers, the others numbers. */
	columns: ReadonlyArray<string>;
	rows: ReadonlyArray<ReadonlyArray<string>>;
	/** E.g. totals. */
	footer?: ReadonlyArray<string>;
}

const { labelledBy, columns, rows, footer } = Astro.props;

/** Row headers are aligned to the start, numbers to the end, so that their digits line up. */
const cellClass = (index: number) => (index === 0 ? "px-4 py-2 text-start" : "px-4 py-2 text-end tabular-nums");
---

<Card className="gap-0 overflow-hidden py-0">
	<table aria-labelledby={labelledBy} class="w-full text-sm/6">
		<thead class="border-b border-border bg-muted/50 text-muted-fg">
			<tr>
				{
					columns.map((column, index) => {
						return (
							<th scope="col" class:list={[cellClass(index), "font-medium"]}>
								{column}
							</th>
						);
					})
				}
			</tr>
		</thead>
		<tbody class="divide-y divide-border">
			{
				rows.map((row) => {
					return (
						<tr>
							{row.map((cell, index) =>
								index === 0 ? (
									<th scope="row" class:list={[cellClass(index), "font-normal text-fg"]}>
										{cell}
									</th>
								) : (
									<td class={cellClass(index)}>{cell}</td>
								),
							)}
						</tr>
					);
				})
			}
		</tbody>
		{
			footer != null && (
				<tfoot class="border-t border-border font-medium text-fg">
					<tr>
						{footer.map((cell, index) =>
							index === 0 ? (
								<th scope="row" class={cellClass(index)}>
									{cell}
								</th>
							) : (
								<td class={cellClass(index)}>{cell}</td>
							),
						)}
					</tr>
				</tfoot>
			)
		}
	</table>
</Card>
