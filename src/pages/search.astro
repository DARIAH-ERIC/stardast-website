---
import { type SearchType, searchIndex, searchTypes } from "#/src/cms/search.ts";
import { buttonStyles } from "#/src/components/button-styles.ts";
import { inputStyles } from "#/src/components/input-styles.ts";
import PageHeader from "#/src/components/page-header.astro";
import Pagination from "#/src/components/pagination.astro";
import PageLayout from "#/src/layouts/page-layout.astro";
import type { PageTracking } from "#/src/lib/analytics/matomo-tracking.ts";
import type { SearchResults } from "#/src/lib/cms/search/types.ts";
import { parsePageParam } from "#/src/lib/pagination.ts";

const perPage = 10;
const maxQueryLength = 200;

/** Search result pages are not indexed by search engines - see also the middleware, which disables caching. */
Astro.response.headers.set("x-robots-tag", "noindex");

const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, maxQueryLength);
const typeParam = Astro.url.searchParams.get("type");
const type = searchTypes.find((option) => option.value === typeParam);
const page = parsePageParam(Astro.url.searchParams.get("page"));

if ((typeParam != null && type == null) || page == null) {
	return new Response(null, { status: 404, headers: { "x-robots-tag": "noindex" } });
}

let results: SearchResults | undefined;
let hasFailed = false;

if (query !== "") {
	try {
		results = await searchIndex.search({
			query,
			types: type != null ? [type.value] : undefined,
			page,
			perPage,
		});
	} catch (error) {
		hasFailed = true;
		Astro.response.status = 503;
		// oxlint-disable-next-line no-console
		console.error("Search failed:", error);
	}
}

const pageCount = results != null ? Math.max(1, Math.ceil(results.total / perPage)) : 1;

if (page > pageCount) {
	return new Response(null, { status: 404, headers: { "x-robots-tag": "noindex" } });
}

function getHref(params: { type?: SearchType; page?: number }): string {
	const searchParams = new URLSearchParams({ q: query });

	if (params.type != null) {
		searchParams.set("type", params.type);
	}

	if (params.page != null && params.page > 1) {
		searchParams.set("page", String(params.page));
	}

	return `/search?${searchParams.toString()}`;
}

const allCount = Object.values(results?.counts ?? {}).reduce((sum, count) => sum + count, 0);

/** Types without results are left out, unless they are the current filter. */
const filters = [
	{ value: undefined, label: "All", count: allCount },
	...searchTypes.map((option) => {
		return { value: option.value, label: option.label, count: results?.counts[option.value] ?? 0 };
	}),
].filter((filter) => filter.value == null || filter.count > 0 || filter.value === type?.value);

const typeLabels: Record<string, string> = Object.fromEntries(
	searchTypes.map((option) => [option.value, option.label]),
);

const pluralize = (count: number) => (count === 1 ? "result" : "results");

/**
 * Reported to analytics as a site search, rather than a page view - once per search, i.e. not again for further pages
 * of its results, and with the search terms in matomo's site search report, rather than in page urls.
 */
const tracking: PageTracking =
	query === ""
		? { kind: "pageView", url: "/search" }
		: page > 1
			? { kind: "none" }
			: { kind: "siteSearch", url: "/search", keyword: query, category: type?.label, resultsCount: results?.total };
---

<PageLayout title={query !== "" ? `Search results for "${query}"` : "Search"} tracking={tracking}>
	<PageHeader title="Search" heading="Search our website" />
	<div class="content-container section-spacing">
		<form role="search" action="/search" method="get" class="flex max-w-2xl flex-wrap gap-3">
			<label for="search-query" class="sr-only">
				Search the site
			</label>
			<input
				id="search-query"
				type="search"
				name="q"
				value={query}
				required
				maxlength={maxQueryLength}
				autocomplete="off"
				class={inputStyles({ class: "min-w-0 flex-1" })}
			/>
			<button type="submit" class={buttonStyles()}>
				Search
			</button>
		</form>

		{hasFailed && (
			<p role="alert" class="mt-8 border border-danger p-4 text-danger">
				Sorry, search is not available right now. Please try again later.
			</p>
		)}

		{results != null && (
			<>
				{/* Announced on page load, so that screen reader users hear the outcome of their search. */}
				<p role="status" class="mt-8 text-foreground-muted">
					{results.total === 0
						? `No ${type != null ? `${type.label.toLowerCase()} ` : ""}results for "${query}".`
						: `${String(results.total)} ${pluralize(results.total)} for "${query}"${type != null ? ` in ${type.label.toLowerCase()}` : ""}.`}
				</p>

				{allCount > 0 && (
					<nav aria-label="Result types" class="mt-6 border-b border-border-strong pb-3">
						<ul class="flex flex-wrap gap-1" role="list">
							{filters.map((filter) => {
								const isCurrent = filter.value === type?.value;

								return (
									<li>
										<a
											href={getHref({ type: filter.value })}
											aria-current={isCurrent ? "page" : undefined}
											class:list={[
												"inline-block px-3 py-2.5 mono-label transition-colors",
												isCurrent
													? "bg-foreground-strong text-background"
													: "text-foreground-strong hover:bg-background-hover",
											]}
										>
											{filter.label} <span class="opacity-70">({filter.count})</span>
										</a>
									</li>
								);
							})}
						</ul>
					</nav>
				)}

				{results.hits.length > 0 && (
					<ol class="mt-8 flex max-w-3xl flex-col" role="list">
						{results.hits.map((hit) => {
							return (
								<li class="border-b border-border">
									<article class="flex flex-col gap-1.5 py-5">
										<p class="mono-label text-foreground-muted">{typeLabels[hit.document.type] ?? hit.document.type}</p>
										<h2 class="text-title text-balance">
											<a href={hit.document.url} class="text-foreground-strong hover:underline underline-offset-4">
												{hit.document.title}
											</a>
										</h2>
										{hit.snippet.length > 0 && (
											<p class="text-pretty text-foreground-muted">
												{hit.snippet.map((segment) =>
													segment.highlight ? (
														<mark class="bg-background-highlight px-0.5 text-foreground-strong">{segment.text}</mark>
													) : (
														segment.text
													),
												)}
											</p>
										)}
									</article>
								</li>
							);
						})}
					</ol>
				)}

				<Pagination
					page={page}
					pageCount={pageCount}
					getHref={(number) => getHref({ type: type?.value, page: number })}
				/>
			</>
		)}
	</div>
</PageLayout>
