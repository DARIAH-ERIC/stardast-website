---
import { getCollection, getLatestRevision, listEntrySummaries } from "#/src/cms/admin.ts";
import { drafts } from "#/src/cms/api.ts";
import { mediaCollectionName } from "#/src/cms/config.ts";
import { AlertCircle, ChevronRight, Plus } from "lucide-react";

import PageHeader from "#/src/components/admin/page-header.astro";
import { Badge } from "#/src/components/admin/ui/badge.tsx";
import { buttonStyles } from "#/src/components/admin/ui/button.tsx";
import { Card } from "#/src/components/admin/ui/card.tsx";
import AdminLayout from "#/src/layouts/admin-layout.astro";

const name = Astro.params.collection!;
const collection = getCollection(name);

if (collection == null) {
	return new Response(null, { status: 404 });
}

/** Media is managed in the media library, and created by uploading. */
if (name === mediaCollectionName) {
	return Astro.redirect("/admin/media");
}

const entries = await listEntrySummaries(name, collection, await getLatestRevision(), await drafts.list());

const statusBadges = {
	changed: { label: "Unpublished changes", intent: "warning" },
	draft: { label: "Not published yet", intent: "secondary" },
	published: undefined,
} as const;
---

<AdminLayout title={collection.label}>
	<PageHeader title={collection.label} description={`${String(entries.length)} ${entries.length === 1 ? "entry" : "entries"}`}>
		<a slot="actions" href={`/admin/collections/${name}/new`} class={buttonStyles()}>
			<Plus aria-hidden="true" />
			New entry
		</a>
	</PageHeader>
	{
		entries.length === 0 ? (
			<div class="rounded-lg border border-dashed border-input p-10 text-center text-sm text-muted-fg">No entries yet.</div>
		) : (
			<Card className="gap-0 overflow-hidden py-0">
				<ul class="divide-y divide-border" role="list">
					{entries.map((entry) => {
						const status = statusBadges[entry.status];

						return (
							<li>
								<a
									href={`/admin/collections/${name}/entries/${entry.id}`}
									class="flex items-center justify-between gap-4 px-4 py-3 -outline-offset-2 hover:bg-muted"
								>
									<span class="flex min-w-0 flex-col">
										<span class="truncate text-sm/6 font-medium text-fg">{entry.label}</span>
										<span class="truncate font-mono text-xs/5 text-muted-fg">{entry.id}</span>
									</span>
									<span class="flex shrink-0 items-center gap-2">
										{!entry.isValid && (
											<Badge intent="danger">
												<AlertCircle aria-hidden="true" data-slot="icon" />
												Needs fixing
											</Badge>
										)}
										{status != null && <Badge intent={status.intent}>{status.label}</Badge>}
										<ChevronRight aria-hidden="true" className="size-4 text-muted-fg" />
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</Card>
		)
	}
</AdminLayout>
