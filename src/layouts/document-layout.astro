---
import { Font } from "astro:assets";

import { env } from "#/configs/env.config.ts";
import { getSharingImage, sharingImageSize } from "#/src/cms/sharing-image.ts";
import JsonLd from "#/src/components/json-ld.astro";
import MatomoAnalytics from "#/src/components/matomo-analytics.astro";
import { locale, siteName } from "#/src/config/project.ts";
import type { JsonLd as JsonLdValue } from "#/src/lib/structured-data.ts";

import "#/src/styles/index.css";

export interface Props {
	/** Page title, without the site name. Omit on the home page to use the site's title. */
	title?: string;
	/** Defaults to the site's description. */
	description?: string;
	/** The id of a media entry, shown when the page is shared. Defaults to the site's sharing image. */
	image?: string;
	/** `article` for e.g. news, `website` otherwise. */
	type?: "article" | "website";
	/**
	 * Path and query of the canonical url, e.g. for filtered or paginated listings. Defaults to the current path without
	 * query, which would otherwise include e.g. `?preview`.
	 */
	canonical?: string;
	/** Schema.org metadata for search engines, see `src/lib/structured-data.ts`. */
	structuredData?: JsonLdValue | ReadonlyArray<JsonLdValue>;
}

const { title, description, image, type = "website", canonical, structuredData } = Astro.props;

const { content } = Astro.locals;

/** Falls back to the site name rather than failing every page - `tests/cms/content.test.ts` checks that it exists. */
const site = await content.singleton("site");

const pageTitle = title ?? site?.title ?? siteName;
const documentTitle = title != null ? `${title} | ${siteName}` : pageTitle;
const pageDescription = description ?? site?.description;
const url = new URL(canonical ?? Astro.url.pathname, Astro.site).href;

const sharingImage = await getSharingImage(content, [image, site?.image], Astro.site);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/icon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{/* `--palette-blue`: meta tags cannot read css variables. */}
		<meta name="theme-color" content="#2b6cb4" />
		<meta name="color-scheme" content="light" />
		<title>{documentTitle}</title>
		{pageDescription != null && <meta name="description" content={pageDescription} />}
		<link rel="canonical" href={url} />
		<link rel="alternate" type="application/rss+xml" title={`${siteName} news`} href="/news/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${siteName} events`} href="/events/rss.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		{pageDescription != null && <meta property="og:description" content={pageDescription} />}
		<meta property="og:url" content={url} />
		{
			sharingImage != null && (
				<>
					<meta property="og:image" content={sharingImage.url} />
					{sharingImage.hasSize && (
						<>
							<meta property="og:image:width" content={String(sharingImageSize.width)} />
							<meta property="og:image:height" content={String(sharingImageSize.height)} />
						</>
					)}
					{sharingImage.alt !== "" && <meta property="og:image:alt" content={sharingImage.alt} />}
				</>
			)
		}
		<meta name="twitter:card" content={sharingImage != null ? "summary_large_image" : "summary"} />
		{
			env.PUBLIC_APP_GOOGLE_SITE_VERIFICATION != null && (
				<meta name="google-site-verification" content={env.PUBLIC_APP_GOOGLE_SITE_VERIFICATION} />
			)
		}
		<Font cssVariable="--font-roboto" preload={[{ subset: "latin", style: "normal" }]} />
		{/* Only for small labels, e.g. dates and navigation, so not preloaded. */}
		<Font cssVariable="--font-roboto-mono" />
		{structuredData != null && <JsonLd value={structuredData} />}
		<MatomoAnalytics />
	</head>
	<body>
		<slot />
	</body>
</html>
