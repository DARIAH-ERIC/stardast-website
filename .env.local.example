# =====================================================================================================================
# environment variables for app
# =====================================================================================================================
#
# Only values which differ per environment, and secrets, belong here. Values which are identical in every environment
# have a default in `./configs/env.schema.ts`.

# =====================================================================================================================
# app
# =====================================================================================================================

# local
# ---------------------------------------------------------------------------------------------------------------------

PUBLIC_APP_BASE_URL="http://localhost:${PORT:-3000}"
# web crawlers
PUBLIC_APP_BOTS="disabled"

# =====================================================================================================================
# media
# =====================================================================================================================

# Where uploads go: `repo` (default) commits them to the content repository, `s3` stores them in an object storage.
# CMS_ASSETS="s3"
# Maximum upload size in megabytes, default 20.
# CMS_MAX_UPLOAD_SIZE=20
# An s3-compatible object storage, e.g. ceph's rados gateway, addressed path-style. Browsers upload directly, so the
# bucket needs a cors rule allowing `PUT`, with a `content-type` header, from the site's origin.
# CMS_S3_ENDPOINT=
# CMS_S3_REGION=
# CMS_S3_BUCKET=
# CMS_S3_ACCESS_KEY_ID=
# CMS_S3_SECRET_ACCESS_KEY=
# CMS_S3_PREFIX="stardast/"
# Resizes and converts images. Without it, the site does so itself, with sharp, and keeps recently used variants in
# memory. Needs to reach the site's `/media/` urls for images in the repository, or the bucket (`IMGPROXY_USE_S3`) for
# images in s3.
# IMGPROXY_BASE_URL="https://imgproxy.acdh.oeaw.ac.at"
# Hex-encoded, as configured for imgproxy. Required in production - unsigned urls are only allowed in `astro dev`.
# IMGPROXY_KEY=
# IMGPROXY_SALT=

# =====================================================================================================================
# analytics
# =====================================================================================================================

# production
# ---------------------------------------------------------------------------------------------------------------------

# PUBLIC_APP_GOOGLE_SITE_VERIFICATION=
# Analytics are only enabled when a site id is set.
# PUBLIC_APP_MATOMO_BASE_URL="https://matomo.acdh.oeaw.ac.at"
# PUBLIC_APP_MATOMO_ID=
# The visitor numbers at `/analytics` need the token of a matomo user with view access only.
# MATOMO_API_TOKEN=

# =====================================================================================================================
# cms
# =====================================================================================================================

# `filesystem` reads `./content/`, `github` reads and commits via the github api. Defaults to `filesystem` in
# `astro dev` only: a production server refuses to start without it.
# CMS_STORAGE="github"
# CMS_GITHUB_REPOSITORY="owner/repo"
# Only for github enterprise server.
# CMS_GITHUB_API_URL=
# In production, a single github app provides both storage and sign-in: installed on CMS_GITHUB_REPOSITORY, with the
# repository permission "contents: read and write", the account permission "email addresses: read", and the callback
# url `<base url>/api/cms/auth/callback`. Storage uses its installation...
# CMS_GITHUB_APP_ID=
# CMS_GITHUB_APP_INSTALLATION_ID=
# CMS_GITHUB_APP_PRIVATE_KEY=
# ...or, in development, a fine-grained personal access token with contents read and write access.
# CMS_GITHUB_TOKEN=

# Sign-in for the admin ui at `/admin`. Defaults to `development` in `astro dev` - signed in as a local user, without any
# setup - and to `github` otherwise, which uses the github app's client id and secret. A separate github oauth app, with
# the same callback url, works too.
# CMS_AUTH="github"
# CMS_GITHUB_OAUTH_CLIENT_ID=
# CMS_GITHUB_OAUTH_CLIENT_SECRET=
# `openssl rand --hex 32`
# CMS_SESSION_SECRET=
# Comma-separated github logins. When not set, everyone with write access to CMS_GITHUB_REPOSITORY may edit.
# CMS_ADMIN_USERS=

# =================================================================================================
# revalidation webhook
# =================================================================================================

# local
# -------------------------------------------------------------------------------------------------

REVALIDATION_WEBHOOK_SECRET=# `openssl rand --hex 32`

# =================================================================================================
# mailing list
# =================================================================================================

# Signups are added as rows to the stardast subscribers table in baserow - table and field ids are constants, see
# `src/lib/newsletter/baserow.ts`. The database token needs permission to create rows in database 1450. The url defaults
# to the acdh instance, so only the token is needed.
# BASEROW_API_BASE_URL="https://baserow.acdh-dev.oeaw.ac.at"
# BASEROW_TOKEN=

# =================================================================================================
# site search
# =================================================================================================

# Without these, site search uses an in-memory index. With them, it uses typesense: each rebuild of the index creates a
# new collection, and switches the alias in TYPESENSE_COLLECTION over to it. The api key needs to manage collections and
# aliases, and is only used on the server.
# TYPESENSE_URL=
# TYPESENSE_API_KEY=
# TYPESENSE_COLLECTION="stardast"
